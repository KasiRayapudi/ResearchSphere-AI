# Python/General
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg-info/

# Virtual environments
backend/venv/

# Node.js
node_modules/

# Build artifacts
build/
Dist/
Dist/**
/dist/**

