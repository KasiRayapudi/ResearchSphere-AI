!.env.example

# Secrets and keys
secrets/

# Database files (SQLite etc.)
*.db
*.sqlite3

# User-uploaded documents must never be committed
backend/uploads/

# Docker dev file (optional)
Dockerfile.dev

# Production secrets - only the example template is tracked
.env.prod
nginx/certs/*
!nginx/certs/.gitkeep

