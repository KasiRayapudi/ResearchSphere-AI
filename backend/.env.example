# ---------------------------------------------------------------------------
# ResearchSphere AI - backend configuration
# Copy to .env and fill in. Every key below is read by app/core/config.py.
# ---------------------------------------------------------------------------

# Application
APP_NAME=ResearchSphere AI
APP_VERSION=1.0.0
DEBUG=true
# development | staging | production
# 'production' disables the SQLite fallback and rejects wildcard CORS origins.
ENVIRONMENT=development

# Security - MUST be overridden with a random 32+ char value outside development
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ALGORITHM=HS256
# Left at 7 days deliberately: the frontend has no refresh logic yet, so
# shortening this would silently log users out mid-session.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=researchsphere-ai
JWT_AUDIENCE=researchsphere-api
JWT_CLOCK_SKEW_SECONDS=30

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_BLOCK_COMMON=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Security headers (all optional; sensible defaults in app/core/config.py)
SECURITY_HEADERS_ENABLED=true
HEADER_X_FRAME_OPTIONS=DENY
HEADER_REFERRER_POLICY=strict-origin-when-cross-origin
HEADER_CROSS_ORIGIN_RESOURCE_POLICY=same-site
HEADER_CROSS_ORIGIN_OPENER_POLICY=same-origin
# COEP breaks the Swagger CDN; enable deliberately if you need cross-origin isolation.
HEADER_CROSS_ORIGIN_EMBEDDER_POLICY=
# HSTS is only ever sent when ENVIRONMENT=production.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Database (full SQLAlchemy URL - not POSTGRES_HOST/PORT/USER pieces)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchsphere_db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=researchsphere_docs

# Google Gemini
GEMINI_API_KEY=

# Embeddings (dimension must match the model and the Qdrant collection)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
# Uploads land here first and are promoted only after validation + scanning.
QUARANTINE_DIR=./uploads/.quarantine

# Upload security
# Allowlist must not outrun what app/rag/document_processor.py can extract.
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt,md,markdown,csv
# Always rejected, even if added to the allowlist above.
BLOCKED_UPLOAD_EXTENSIONS=exe,dll,bat,cmd,com,sh,bash,ps1,js,mjs,py,rb,pl,jar,class,msi,scr,vbs,app,deb,rpm,so,dylib,zip,rar,7z,tar,gz,iso,img
ENABLE_DUPLICATE_DETECTION=true
# Registered scanner name from app/services/antivirus.py ("noop" = no scanning)
VIRUS_SCANNER=noop

# CORS - explicit comma-separated allowlist. Never "*" in production.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Trusted Host header allowlist (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1

# Redis - optional. Leave blank to disable Redis checks entirely.
REDIS_URL=redis://localhost:6379
