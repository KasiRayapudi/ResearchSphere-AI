# ---------------------------------------------------------------------------
# ResearchSphere AI - backend configuration
# Copy to .env and fill in. Every key below is read by app/core/config.py.
# ---------------------------------------------------------------------------

# Application
APP_NAME=ResearchSphere AI
APP_VERSION=1.0.0
DEBUG=true
# development | staging | production
# 'production' disables the SQLite fallback and rejects wildcard CORS origins.
ENVIRONMENT=development

# Security - MUST be overridden with a random 32+ char value outside development
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ALGORITHM=HS256
# Left at 7 days deliberately: the frontend has no refresh logic yet, so
# shortening this would silently log users out mid-session.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=researchsphere-ai
JWT_AUDIENCE=researchsphere-api
JWT_CLOCK_SKEW_SECONDS=30

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_BLOCK_COMMON=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Security headers (all optional; sensible defaults in app/core/config.py)
SECURITY_HEADERS_ENABLED=true
HEADER_X_FRAME_OPTIONS=DENY
HEADER_REFERRER_POLICY=strict-origin-when-cross-origin
HEADER_CROSS_ORIGIN_RESOURCE_POLICY=same-site
HEADER_CROSS_ORIGIN_OPENER_POLICY=same-origin
# COEP breaks the Swagger CDN; enable deliberately if you need cross-origin isolation.
HEADER_CROSS_ORIGIN_EMBEDDER_POLICY=
# HSTS is only ever sent when ENVIRONMENT=production.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# Database (full SQLAlchemy URL - not POSTGRES_HOST/PORT/USER pieces)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchsphere_db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=researchsphere_docs

# Google Gemini
GEMINI_API_KEY=

# Embeddings (dimension must match the model and the Qdrant collection)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
# Uploads land here first and are promoted only after validation + scanning.
QUARANTINE_DIR=./uploads/.quarantine

# Object storage
# --------------
# Which backend holds document bytes: filesystem | s3 | minio.
#
# "filesystem" is the default and matches the behaviour this project has
# always had. It is fine for development and for a single node, but the API
# cannot be scaled past one replica with it: a second replica cannot read
# what the first one wrote. Production should use s3 or minio.
#
# Only the key is stored in the database, never a path or a bucket name, so
# switching providers does not rewrite any rows -- but objects do not move
# themselves. Documents uploaded under one provider stay where they are.
STORAGE_PROVIDER=filesystem

# Where the filesystem provider keeps objects. Defaults to UPLOAD_DIR when
# empty, so an existing deployment keeps using the directory it already has.
FILESYSTEM_ROOT=

# --- AWS S3 (STORAGE_PROVIDER=s3) ---
# Leave the credentials empty on AWS: boto3 will use the instance profile or
# the IRSA role, which is preferable to long-lived keys in an env file.
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for an S3-compatible service that is not AWS. Normally blank.
AWS_ENDPOINT_URL=

# --- MinIO (STORAGE_PROVIDER=minio) ---
# MinIO speaks the S3 API, so the same provider serves both; the difference
# is the endpoint and path-style addressing. The scheme is required.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Downloads ---
# Lifetime of a signed download URL, in seconds. The URL is the credential:
# anyone holding the link can fetch the document until it expires, so keep
# this just long enough for the click. Range 30..604800 (SigV4's ceiling).
SIGNED_URL_EXPIRE_SECONDS=300

# --- Housekeeping (storage.cleanup, runs daily) ---
# An object must be older than this before the sweep will treat it as an
# orphan. An upload writes the object before it commits the row, so a short
# window here risks deleting a file that is about to become live.
STORAGE_CLEANUP_GRACE_HOURS=24
# Age at which an abandoned quarantine or temporary file is removed.
STORAGE_TEMP_RETENTION_HOURS=6
# How long the bytes of a document that failed indexing are kept. The failure
# row is never deleted, only the object it points at. 0 keeps them forever.
STORAGE_FAILED_RETENTION_DAYS=30
# Ceiling on deletions per sweep, so a mistake is capped and shows up in the
# run statistics rather than emptying a bucket.
STORAGE_CLEANUP_MAX_DELETES=500

# Upload security
# Allowlist must not outrun what app/rag/document_processor.py can extract.
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt,md,markdown,csv
# Always rejected, even if added to the allowlist above.
BLOCKED_UPLOAD_EXTENSIONS=exe,dll,bat,cmd,com,sh,bash,ps1,js,mjs,py,rb,pl,jar,class,msi,scr,vbs,app,deb,rpm,so,dylib,zip,rar,7z,tar,gz,iso,img
ENABLE_DUPLICATE_DETECTION=true
# Registered scanner name from app/services/antivirus.py ("noop" = no scanning)
VIRUS_SCANNER=noop

# CORS - explicit comma-separated allowlist. Never "*" in production.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Trusted Host header allowlist (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1

# Redis - optional. Leave blank to disable Redis checks entirely.
REDIS_URL=redis://localhost:6379
