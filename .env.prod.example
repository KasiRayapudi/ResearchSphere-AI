###############################################################################
# ResearchSphere AI - production environment
#
#   cp .env.prod.example .env.prod
#   # fill in every value marked REQUIRED, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Values marked REQUIRED have no default. Compose refuses to start without
# them, and the backend validates them again at startup.
###############################################################################

# --- Application secret -------------------------------------------------
# REQUIRED. Generate with:  openssl rand -base64 48
# Rotating this invalidates every existing access and refresh token.
SECRET_KEY=

# --- Google Gemini ------------------------------------------------------
# REQUIRED in production: chat, research and report generation fail without it.
GEMINI_API_KEY=

# --- PostgreSQL ---------------------------------------------------------
# REQUIRED. The database is not published to the host in the production stack.
POSTGRES_USER=researchsphere
POSTGRES_PASSWORD=
POSTGRES_DB=researchsphere_db

# --- Redis --------------------------------------------------------------
# REQUIRED. Redis backs distributed rate limiting and the token blacklist.
# Generate with:  openssl rand -base64 32
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# --- Qdrant -------------------------------------------------------------
QDRANT_COLLECTION=researchsphere_docs
# Qdrant runs without authentication on purpose: it publishes no port and is
# reachable only from the internal backend_net. There is deliberately no
# QDRANT_API_KEY here -- setting one would make Qdrant reject the backend,
# which has no matching client configuration.

# --- Public URLs and host allowlists ------------------------------------
# REQUIRED. Must be the real origin users reach; plain HTTP triggers a
# production warning, and a wildcard is rejected outright.
FRONTEND_URL=https://researchsphere.example.com
CORS_ORIGINS=https://researchsphere.example.com
TRUSTED_HOSTS=researchsphere.example.com

# --- Edge ports ---------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# --- Tuning -------------------------------------------------------------
# Uvicorn workers. Embeddings load a model per worker, so raising this
# increases memory roughly linearly.
WEB_CONCURRENCY=4
# Seconds in-flight requests (including SSE chat streams) get to finish.
GRACEFUL_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=50

# --- Token lifetimes ----------------------------------------------------
# Left at 7 days: the frontend consumes /auth/refresh, but shortening this
# should be done deliberately and verified against the client.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Image tag ----------------------------------------------------------
# Which build of the application images to run.
#
#   Git tag v1.2.0  ->  published image tags 1.2.0, 1.2, 1 and sha-<40 hex>
#
# The leading "v" belongs to the Git tag only; it is never part of an image
# tag. There is no "latest": the release workflow runs on tags alone, so it
# never publishes one, and production pins a version deliberately rather than
# following a moving target.
#
#   published images (make prod-pull):  set this to a published tag, e.g. 1.2.0
#   local build      (make prod):       any label you like; "local" is the
#                                       default and marks the image as built
#                                       from this working tree
IMAGE_TAG=local
