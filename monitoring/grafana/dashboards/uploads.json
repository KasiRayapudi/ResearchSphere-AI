        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "increase(researchsphere_uploads_total{job=\"researchsphere-backend\",outcome=\"duplicate\"}[24h])",
          "legendFormat": "",
