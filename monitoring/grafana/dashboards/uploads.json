        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "increase(researchsphere_uploads_total{job=\"researchsphere-backend\",outcome=\"failed\"}[24h])",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
