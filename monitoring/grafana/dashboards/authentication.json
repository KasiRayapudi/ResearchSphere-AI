{
  "uid": "rs-auth",
  "title": "ResearchSphere - Authentication",
  "description": "Sign-in health and credential-attack signals.",
  "tags": [
    "researchsphere",
    "security",
    "auth"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Auth attempts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "researchsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "sum(rate(researchsphere_auth_attempts_total{job=\"researchsphere-backend\"}[5m])) by (action, outcome)",
          "legendFormat": "{{action}} / {{outcome}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Login failures by reason",
      "description": "A rise in unknown_email suggests enumeration; a rise in bad_password against few accounts suggests credential stuffing.",
      "datasource": {
        "type": "prometheus",
        "uid": "researchsphere-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "sum(rate(researchsphere_auth_failures_total{job=\"researchsphere-backend\"}[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "Refresh-token reuse (1h)",
      "description": "Any non-zero value means a refresh token was replayed and a whole token family was revoked. Investigate.",
      "datasource": {
        "type": "prometheus",
        "uid": "researchsphere-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "increase(researchsphere_token_refresh_reuse_total{job=\"researchsphere-backend\"}[1h])",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "Failed-login ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "researchsphere-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "sum(rate(researchsphere_auth_attempts_total{job=\"researchsphere-backend\",action=\"login\",outcome=\"failure\"}[5m])) / clamp_min(sum(rate(researchsphere_auth_attempts_total{job=\"researchsphere-backend\",action=\"login\"}[5m])), 0.001)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "timeseries",
      "title": "Authorization denials",
      "description": "workspace_isolation denials indicate cross-tenant access attempts.",
      "datasource": {
        "type": "prometheus",
        "uid": "researchsphere-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "sum(rate(researchsphere_authz_denials_total{job=\"researchsphere-backend\"}[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
