{
  "uid": "rs-errors",
  "title": "ResearchSphere - Errors",
  "description": "Failures by type, route and dependency.",
  "tags": [
    "researchsphere",
    "errors"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "5xx rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "researchsphere-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "researchsphere-prometheus"
          },
          "expr": "sum(rate(researchsphere_http_requests_total{job=\"researchsphere-backend\",status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(researchsphere_http_requests_total{job=\"researchsphere-backend\"}[5m])), 0.001)",
          "legendFormat": "",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
